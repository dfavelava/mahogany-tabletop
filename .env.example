CONNECTOME_API_BASE_URL=http://localhost:8080/api/connectome
CONNECTOME_API_KEY=your-api-key
DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional: sync slash commands to one guild for instant availability during
# development, instead of the up-to-an-hour propagation delay for a global
# sync. Leave unset in production.
DISCORD_GUILD_ID=
# Optional: comma-separated Discord user ids to grant GM visibility on
# startup. Fixed config rather than a slash command, so nobody can grant
# themselves GM visibility by typing a command.
DISCORD_GM_USER_IDS=
# Optional: Ollama server and model used by the LLM client (llm.py). The bot
# starts fine when Ollama is unreachable; LLM features just degrade.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
